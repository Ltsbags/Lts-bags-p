# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for self-hosted production deployment
DATABASE_URL="postgresql://postgres:password@localhost:5432/apexbags?schema=public"

# ADMIN_EMAIL & PASSWORD: Initial admin credentials for login
ADMIN_EMAIL="admin@apexbags.com"
ADMIN_PASSWORD="admin_secure_password_123"

# JWT_SECRET: Secret key for signing admin authentication tokens
JWT_SECRET="apex_bags_super_secret_jwt_key_2026"

